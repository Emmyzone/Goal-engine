# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Database (Render Postgres connection string, or local)
DATABASE_URL=postgresql://user:password@localhost:5432/goal_engine
# Set to true when connecting to Render/hosted Postgres that requires SSL
DATABASE_SSL=false

# AI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
